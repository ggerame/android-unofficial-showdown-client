<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="96dp"
        android:paddingStart="12dp"
        android:paddingEnd="8dp"
        android:background="@drawable/bg_selectable_item_solid">

    <TextView
            android:id="@+id/text_view_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="48dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceListItem"/>

    <ImageView
            android:id="@+id/image_view_pokemon1"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_below="@+id/text_view_title"
            android:layout_marginStart="4dp"
            android:scaleType="fitCenter"/>

    <ImageView
            android:id="@+id/image_view_pokemon2"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_below="@id/text_view_title"
            android:layout_toEndOf="@+id/image_view_pokemon1"
            android:layout_marginStart="4dp"
            android:scaleType="fitCenter"/>

    <ImageView
            android:id="@+id/image_view_pokemon3"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_below="@id/text_view_title"
            android:layout_toEndOf="@+id/image_view_pokemon2"
            android:layout_marginStart="4dp"
            android:scaleType="fitCenter"/>

    <ImageView
            android:id="@+id/image_view_pokemon4"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_below="@id/text_view_title"
            android:layout_toEndOf="@+id/image_view_pokemon3"
            android:layout_marginStart="4dp"
            android:scaleType="fitCenter"/>

    <ImageView
            android:id="@+id/image_view_pokemon5"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_below="@id/text_view_title"
            android:layout_toEndOf="@+id/image_view_pokemon4"
            android:layout_marginStart="4dp"
            android:scaleType="fitCenter"/>

    <ImageView
            android:id="@+id/image_view_pokemon6"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_below="@id/text_view_title"
            android:layout_toEndOf="@+id/image_view_pokemon5"
            android:layout_marginStart="4dp"
            android:scaleType="fitCenter"/>

    <ImageButton
            android:id="@+id/copy_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            android:contentDescription="@string/copy_team"
            android:padding="12dp"
            android:src="@drawable/ic_copy"
            android:background="?selectableItemBackgroundBorderless"
            app:tint="@color/divider"/>

    <ImageButton
            android:id="@+id/delete_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentEnd="true"
            android:layout_below="@id/copy_button"
            android:background="?selectableItemBackgroundBorderless"
            android:contentDescription="@string/delete_team"
            android:padding="12dp"
            android:src="@drawable/ic_delete"
            app:tint="@color/error"/>

</RelativeLayout>
